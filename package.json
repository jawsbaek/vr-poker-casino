{
  "name": "vr-poker-casino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "deploy": "! find public/models -name '*.glb' -size +5M | grep . || (echo 'GLB over 5MB: compress with gltf-transform optimize --compress meshopt --texture-compress webp' && false) && npm run build && gcloud run deploy vr-poker-casino --source . --region asia-northeast3 --allow-unauthenticated --port 8080 --quiet",
    "dogfood": "node scripts/dogfood_visual_loop.mjs",
    "verify:ux": "node scripts/verify_ux_guideline_harness.mjs",
    "verify:algo": "node scripts/verify_algorithms.mjs",
    "verify:hud": "node scripts/verify_poker_hud.mjs",
    "blender:generate": "/Applications/Blender.app/Contents/MacOS/Blender -b -P scripts/blender_generate_vip_assets.py",
    "blender:dealer": "/Applications/Blender.app/Contents/MacOS/Blender -b -P scripts/blender_generate_dealer.py",
    "blender:ai-players": "/Applications/Blender.app/Contents/MacOS/Blender -b -P scripts/blender_generate_ai_players.py",
    "video:demo": "node scripts/record_demo_video.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
